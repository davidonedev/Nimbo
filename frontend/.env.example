# Endereço da API. O sufixo /api é acrescentado sozinho se faltar.
# Local:     http://localhost:3333/api
# Produção:  https://nimbo-api-duyl.onrender.com
VITE_API_URL=https://seu-backend.onrender.com

# Endereço público do site (domínio próprio), usado nos textos "seudominio.com/seu-negocio" e nas tags canonical/og:url
# do HTML. Defina na Vercel (Settings > Environment Variables) depois de ligar o domínio. Vazio = usa o endereço aberto.
# VITE_SITE_URL=https://seudominio.com

# Captcha gratuito da Cloudflare (Turnstile) no agendamento público. Vazio = sem captcha.
# Chave de teste que sempre passa: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
