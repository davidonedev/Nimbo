# ─── Banco de Dados (banco separado do backend Node — agendepro_java) ─────────
DB_URL=jdbc:postgresql://localhost:5432/agendepro_java
DB_USERNAME=postgres
DB_PASSWORD=root

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3333

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=seu-segredo-super-secreto-mude-em-producao
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Lista separada por vírgula, sem barra no final. Aceita origem exata e padrão com curinga (previews da Vercel).
# Produção (Render): CORS_ALLOWED_ORIGINS=https://nimbo-dusky.vercel.app,https://nimbo-*.vercel.app
# CORS_ORIGIN (nome antigo) continua valendo se CORS_ALLOWED_ORIGINS não existir.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Upload de Arquivos ───────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ─── Segurança ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ─── E-mail (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgendePro <noreply@agendepro.com>

# URL pública do frontend (usada nos links de e-mail/WhatsApp)
APP_URL=http://localhost:5173

# ─── Seed de dados de demonstração ─────────────────────────────────────────────
# true = popula o banco com tenants/profissionais/serviços de exemplo ao subir
SEED_ENABLED=false

# ─── Confirmação do agendamento por celular ───────────────────────────────────
# Padrão (grátis, sem chip): o cliente reserva o horário (fica PENDENTE) e confirma mandando uma mensagem para o
# WhatsApp do estabelecimento; o dono confirma em Agendamentos. Sem confirmação no prazo, o horário é liberado.
# Prazo do CLIENTE para tocar em "Confirmar no WhatsApp" (minutos). Se não tocar, o horário é liberado; depois que toca,
# o horário fica reservado sem prazo até o dono confirmar.
PENDING_CONFIRM_MINUTES=180
# Aviso por e-mail ao dono (tenant.email) 2 h e 1 h antes de um horário que o cliente confirmou e ele ainda não. Precisa de SMTP.
OWNER_REMINDERS_ENABLED=true

# Fila de avisos: pedido novo/cancelamento/remarcação → dono (e-mail e WhatsApp do telefone cadastrado); aprovação/recusa/
# cancelamento → cliente (e-mail se tiver, e WhatsApp). Canal sem configuração é ignorado, sem nova tentativa.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_MAX_ATTEMPTS=5
# Opcional — confirmação automática por código de 6 dígitos: sai pelo WhatsApp do estabelecimento (Configurações →
# Portal do Cliente → Integração WhatsApp) ou, se ele não tiver, por este número padrão da plataforma (Evolution API).
WHATSAPP_DEFAULT_API_URL=
WHATSAPP_DEFAULT_API_KEY=
WHATSAPP_DEFAULT_INSTANCE=
# Captcha gratuito (Cloudflare Turnstile). Em produção defina a chave secreta; o front usa VITE_TURNSTILE_SITE_KEY.
# Chaves de teste da Cloudflare (sempre passam): site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# Pedidos de agendamento por IP em 15 min
BOOKING_MAX_ATTEMPTS_PER_IP=10
